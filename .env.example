# ────────────────────────────────────────────────────────────────────────────
# ScholarNexus environment variables
# ────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust values as needed.
# NEVER commit your real .env file to git (it is gitignored by default).

# Prisma database connection string.
# Default: SQLite file at ./db/custom.db (relative to project root).
# For production, use a real DB: postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./db/custom.db"

# Optional — IEEE Xplore API key (improves IEEE search results).
# Without a key, IEEE searches are skipped silently.
# Get one at: https://developer.ieee.org/
IEEE_API_KEY=""

# Optional — CORE API key (improves CORE search results).
# Without a key, CORE is excluded from the default source set.
# Get one at: https://core.ac.uk/services/api
CORE_API_KEY=""

# Node environment (development | production)
NODE_ENV="development"
