# Local PostgreSQL. These development credentials match compose.yaml.
DATABASE_URL="postgresql://scholar:scholar_local@127.0.0.1:5432/scholar_nexus?schema=public&connect_timeout=5"
# Single-user local application. Do not expose it to a network without authentication.
LOCAL_APP_URL="http://127.0.0.1:3000"
# Baseline search needs no AI or provider keys.
AI_ENABLED="false"
# Optional OpenAI-compatible endpoint, e.g. a local inference server.
AI_BASE_URL=""
AI_MODEL=""
AI_API_KEY=""
# Optional real contact email for provider requests. Leave blank if not configured.
ACADEMIC_CONTACT_EMAIL=""
OPENALEX_API_KEY=""
SEMANTIC_SCHOLAR_API_KEY=""
IEEE_API_KEY=""
CORE_API_KEY=""
