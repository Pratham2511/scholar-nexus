// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A lightweight, local "current user" profile used to scope saved papers and search history.
// The app uses a single demo profile (id="local") by default for simplicity.
model UserProfile {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  affiliation String?
  researchInterests String?
  followedAuthors  String   @default("[]") // JSON array of author names
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedPapers   SavedPaper[]
  searchHistory SearchHistory[]
  favoriteTopics FavoriteTopic[]
  exportHistory  ExportRecord[]
  collections   Collection[]
  searchAlerts  SearchAlert[]
  paperQAs      PaperQA[]
}

model SavedPaper {
  id          String   @id @default(cuid())
  userId      String
  paperId     String
  title       String
  authors     String
  abstract    String?
  year        Int?
  doi         String?
  pdfLink     String?
  citationCount Int?
  publisher   String?
  source      String?
  keywords    String?
  openAccess  Boolean  @default(false)
  aiSummary   String?
  savedAt     DateTime @default(now())

  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paperId])
}

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String
  query       String
  filters     String?
  resultCount Int?
  createdAt   DateTime @default(now())

  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FavoriteTopic {
  id          String   @id @default(cuid())
  userId      String
  topic       String
  createdAt   DateTime @default(now())

  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId])
}

model ExportRecord {
  id          String   @id @default(cuid())
  userId      String
  paperTitle  String
  format      String
  createdAt   DateTime @default(now())

  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────
// V2 MODELS — Collections / Reading Lists
// ──────────────────────────────────────────────────────────────────────────
model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  papers      CollectionPaper[]

  @@index([userId])
}

model CollectionPaper {
  id           String     @id @default(cuid())
  collectionId String
  paperId      String
  notes        String?
  addedAt      DateTime   @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([paperId])
}

// ──────────────────────────────────────────────────────────────────────────
// V2 MODELS — Search Alerts
// ──────────────────────────────────────────────────────────────────────────
model SearchAlert {
  id          String    @id @default(cuid())
  userId      String
  query       String
  filters     String    @default("{}") // JSON string of SearchFilters
  frequency   String    @default("weekly") // "daily" | "weekly"
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())

  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────
// V2 MODELS — Paper Q&A Cache (PDF full-text Q&A)
// ──────────────────────────────────────────────────────────────────────────
model PaperQA {
  id        String   @id @default(cuid())
  userId    String
  paperId   String
  question  String
  answer    String
  createdAt DateTime @default(now())

  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paperId])
}
